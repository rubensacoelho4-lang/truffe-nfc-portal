# Copie ce fichier en `.env` et remplis les valeurs pour activer le cloud save
# et le classement global. Sans ces variables, le jeu tourne 100% en local.
#
# EXPO_PUBLIC_* = exposé côté client (uniquement la clé ANON publique, JAMAIS de secret).
# Le service_role key ne doit JAMAIS être ici ni côté app.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...votre_cle_anon_publique
